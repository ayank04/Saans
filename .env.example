# SAANS Platform Environment Configuration Example
# Copy to .env and supply actual credentials. NEVER commit .env to source control!

# Database Configuration (PostgreSQL / Supabase with PostGIS)
# NOTE: If your password contains special characters like '@', they must be URL-encoded (e.g. '@' -> '%40')
DATABASE_URL=postgresql+psycopg://postgres:your_password_encoded@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Backend Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environmental Data Provider API Keys
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
NASA_FIRMS_API_KEY=your_nasa_firms_key_here
OPENAQ_API_KEY=your_openaq_api_key_here

# Automated Scheduler Configuration
CPCB_INGESTION_INTERVAL_SECONDS=900
CPCB_SCHEDULER_ENABLED=true
ENABLE_EMBEDDED_SCHEDULER=false
DATA_STALENESS_HOURS=4.0

